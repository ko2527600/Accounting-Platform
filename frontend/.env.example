# Mono Connect public key - required to enable linking real bank feeds on
# the Bank Reconciliation page. Public keys are safe to expose client-side.
# Get one at https://app.mono.co. Without this, the "Link Bank Account"
# button is disabled and a "not configured" notice is shown instead.
VITE_MONO_PUBLIC_KEY=""

# Base URL of the deployed backend API, including the /api/v1 prefix (e.g.
# https://ledgio-backend.onrender.com/api/v1). Falls back to the local dev
# backend (http://localhost:4000/api/v1) when unset - only needs to be set
# for production builds (e.g. as a Vercel project environment variable).
VITE_API_BASE_URL=""

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Set this to track page
# views across the Ledgio app. Traffic data is then visible in the Core Control
# Engine's Analytics tab (backed by GA4 Data API + a service account on the backend).
# Leave blank to disable tracking entirely.
VITE_GA_MEASUREMENT_ID=""

# Paystack public (publishable) key — safe to expose client-side. Used on the
# subscription payment flow. Get it from Paystack Dashboard > Settings > API Keys.
# Use pk_test_... for test mode, pk_live_... for production.
VITE_PAYSTACK_PUBLIC_KEY=""
