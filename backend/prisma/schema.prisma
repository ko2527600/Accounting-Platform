// Prisma schema file for Multi-Tenant Accounting Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Used only for `prisma migrate deploy`/`migrate dev` and other admin
  // operations that need session continuity (e.g. against Prisma Postgres,
  // where DATABASE_URL is the pooled connection). Must always be set even
  // when there's no separate pooler - Prisma errors if this env var is
  // missing once directUrl is declared, so DIRECT_URL is set to the same
  // value as DATABASE_URL everywhere except a real pooled setup.
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                   String    @id @default(uuid())
  name                 String
  slug                 String    @unique
  schema               String    @unique
  acceptedTermsVersion String?   @map("accepted_terms_version")
  termsAcceptedAt      DateTime? @map("terms_accepted_at")
  tier                 Int       @default(1)
  baseCurrency         String    @default("USD") @map("base_currency")
  // "BUSINESS" | "NONPROFIT" - chosen once at onboarding, drives which nav
  // sections the frontend shows (hides POS/Inventory for nonprofits, shows
  // Funds). Immutable after onboarding this pass - not editable via
  // PUT /tenants/current. Plain string, not a Prisma enum, matching how
  // `tier`/`baseCurrency` aren't enums either.
  orgType              String    @default("BUSINESS") @map("org_type")
  // Guided onboarding wizard fields (Phase 3 trust feature). businessType is
  // freeform-ish (e.g. "Sole Proprietor"/"Partnership"/"Limited Company") -
  // not a Prisma enum, same convention as orgType/tier. `isLive` flips true
  // only once the opening-balances step posts a real, server-validated
  // balanced trial balance (see onboardingWizardService.ts) - a hard gate in
  // code, never set directly from a client-supplied boolean.
  businessType         String?   @map("business_type")
  vatRegistered        Boolean   @default(false) @map("vat_registered")
  graTin               String?   @map("gra_tin")
  isLive               Boolean   @default(false) @map("is_live")
  // Owner/manager phone number that automated SMS alerts (till-close
  // summaries, cash shortage warnings) go to. Optional - alerts are skipped
  // (not sent to a shared/hardcoded fallback) when unset for this tenant.
  bossPhone            String?   @map("boss_phone")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  users       User[]
  invitations Invitation[]

  @@index([acceptedTermsVersion, termsAcceptedAt])
  @@map("tenants")
}

model Invitation {
  id           String   @id @default(uuid())
  email        String
  tenantId     String   @map("tenant_id")
  role         String   @default("Viewer")
  // Warehouse IDs to grant on acceptance, only meaningful when role is a
  // location-scoped role ('Shop Manager'/'Cashier') - empty for company-wide roles.
  warehouseIds String[] @default([]) @map("warehouse_ids")
  token        String   @unique
  status       String   @default("PENDING")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([token])
  @@index([email])
  @@map("invitations")
}

model User {
  id                     String   @id @default(uuid())
  email                  String   @unique
  password               String
  name                   String
  phone                  String?
  role                   String   @default("Viewer")
  tenantId               String?  @map("tenant_id")
  isActive               Boolean  @default(true) @map("is_active")
  isEmailVerified        Boolean  @default(false) @map("is_email_verified")
  isPhoneVerified        Boolean  @default(false) @map("is_phone_verified")
  emailVerificationToken String?  @map("email_verification_token")
  smsVerificationCode    String?  @map("sms_verification_code")
  isMfaEnabled           Boolean  @default(false) @map("is_mfa_enabled")
  totpSecret             String?  @map("totp_secret")
  mfaBackupCodes         String[] @default([]) @map("mfa_backup_codes")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  tenant          Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseAccess WarehouseAccess[]

  @@index([tenantId])
  @@index([email, tenantId])
  @@index([isActive])
  @@map("users")
}

model WarehouseAccess {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  userId      String   @map("user_id")
  warehouseId String   @map("warehouse_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([userId, warehouseId])
  @@index([tenantId])
  @@index([userId])
  @@index([warehouseId])
  @@map("warehouse_access")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  VOID
}

model Account {
  id        String      @id @default(uuid())
  code      String      @unique
  name      String
  type      AccountType
  parentId  String?     @map("parent_id")
  currency  String      @default("USD")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  parent            Account?           @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          Account[]          @relation("AccountHierarchy")
  journalEntryLines JournalEntryLine[]
  ledgers           Ledger[]

  @@index([parentId])
  @@index([type])
  @@index([isActive])
  @@index([type, isActive])
  @@map("accounts")
}

model JournalEntry {
  id          String             @id @default(uuid())
  entryNumber String             @unique @map("entry_number")
  entryDate   DateTime           @default(now()) @map("entry_date")
  description String?
  status      JournalEntryStatus @default(DRAFT)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  lines   JournalEntryLine[]
  ledgers Ledger[]

  @@index([status])
  @@index([entryDate])
  @@index([status, entryDate])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String   @id @default(uuid())
  journalEntryId String   @map("journal_entry_id")
  accountId      String   @map("account_id")
  debit          Decimal  @default(0.00) @db.Decimal(15, 2)
  credit         Decimal  @default(0.00) @db.Decimal(15, 2)
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@index([journalEntryId, createdAt])
  @@map("journal_entry_lines")
}

model Ledger {
  id              String   @id @default(uuid())
  accountId       String   @map("account_id")
  transactionDate DateTime @default(now()) @map("transaction_date")
  journalEntryId  String?  @map("journal_entry_id")
  debit           Decimal  @default(0.00) @db.Decimal(15, 2)
  credit          Decimal  @default(0.00) @db.Decimal(15, 2)
  balance         Decimal  @default(0.00) @db.Decimal(15, 2)
  description     String?
  createdAt       DateTime @default(now()) @map("created_at")

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([accountId, transactionDate(sort: Desc), createdAt(sort: Desc)])
  @@index([journalEntryId])
  @@index([transactionDate])
  @@index([accountId])
  @@map("ledgers")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   String?
  // Structured before/after diff for update-style events (e.g. journal entry
  // status DRAFT -> POSTED). Complements `details`, the human-readable summary.
  changes   Json?
  userId    String?  @map("user_id")
  userEmail String?  @map("user_email")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([entity])
  @@index([userId])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model ReportSchedule {
  id         String    @id @default(uuid())
  tenantId   String    @unique @map("tenant_id")
  frequency  String    @default("Weekly")
  dayOfWeek  Int       @default(1) @map("day_of_week")
  dayOfMonth Int       @default(1) @map("day_of_month")
  hourUtc    Int       @default(8) @map("hour_utc")
  reportType String    @default("ProfitAndLoss") @map("report_type")
  recipients String[]
  enabled    Boolean   @default(true)
  lastSentAt DateTime? @map("last_sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("report_schedules")
}

model BankAccount {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  accountName     String    @map("account_name")
  accountNumber   String    @map("account_number")
  bankName        String    @map("bank_name")
  currency        String    @default("USD")
  currentBalance  Decimal   @default(0.00) @map("current_balance") @db.Decimal(15, 2)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  monoAccountId   String?   @unique @map("mono_account_id")
  institutionName String?   @map("institution_name")
  lastSyncedAt    DateTime? @map("last_synced_at")

  transactions BankTransaction[]

  @@index([tenantId])
  @@map("bank_accounts")
}

model BankTransaction {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  bankAccountId     String   @map("bank_account_id")
  amount            Decimal  @db.Decimal(15, 2)
  payee             String
  description       String?
  postedDate        DateTime @default(now()) @map("posted_date")
  status            String   @default("UNRECONCILED")
  ledgerId          String?  @map("ledger_id")
  monoTransactionId String?  @unique @map("mono_transaction_id")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bankAccountId])
  @@index([status])
  @@map("bank_transactions")
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  email     String
  phone     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  invoices Invoice[]

  @@index([tenantId])
  @@map("customers")
}

model Invoice {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  invoiceNumber      String   @map("invoice_number")
  customerId         String   @map("customer_id")
  issueDate          DateTime @default(now()) @map("issue_date")
  dueDate            DateTime @map("due_date")
  currency           String   @default("USD")
  exchangeRate       Decimal  @default(1.0000) @map("exchange_rate") @db.Decimal(10, 4)
  subtotal           Decimal  @db.Decimal(15, 2)
  tax                Decimal  @default(0.00) @db.Decimal(15, 2)
  taxRateId          String?  @map("tax_rate_id")
  // Snapshot of the tax rate's components at issue time (name/rate/amount per
  // levy), so a later edit to the TaxRate's components never rewrites the
  // history of what was actually charged on this invoice - same reasoning as
  // `subtotal`/`tax`/`total` already being snapshotted rather than derived live.
  taxBreakdown       Json?    @map("tax_breakdown")
  total              Decimal  @db.Decimal(15, 2)
  baseCurrencyAmount Decimal? @map("base_currency_amount") @db.Decimal(15, 2)
  // Cumulative amount actually received against this invoice, in the
  // invoice's own (native) currency - same currency `total` is in, not
  // `baseCurrencyAmount`. Each InvoicePayment row is the audit trail of how
  // this figure was built up; this column exists so "how much is still
  // owed" (total - amountPaid) never requires summing the history at read
  // time. status moves DRAFT -> SENT -> PARTIALLY_PAID -> PAID as this
  // grows from 0 to total (a credit note can also move it back down - see
  // creditDebitNoteService.ts).
  amountPaid         Decimal  @default(0.00) @map("amount_paid") @db.Decimal(15, 2)
  status             String   @default("DRAFT")
  // When the invoice document was last actually emailed to the customer -
  // distinct from `status`, which already gets set to "SENT" at creation
  // regardless of whether any email was ever sent (see invoices.ts's create
  // handler). Null means never emailed; re-sending updates it, it isn't a
  // count of sends.
  emailedAt          DateTime? @map("emailed_at")
  // Last time an overdue-payment reminder (dunning email) was sent for this
  // invoice - used to dedup the daily DunningReminderCronService sweep so an
  // overdue invoice isn't re-emailed more than once per day.
  lastReminderSentAt DateTime? @map("last_reminder_sent_at")
  journalId          String?  @map("journal_id")
  // Optional restricted/unrestricted fund this invoice's revenue belongs to
  // (fund accounting for nonprofit tenants) - flows onto every journal line
  // posted at payment time (see invoicePaymentService.markInvoicePaid), so
  // the whole payment stays within one fund by construction.
  fundId             String?  @map("fund_id")
  // Set together, only on an itemized invoice (mirrors VendorBill's
  // warehouseId/lines shape for the purchase side) - the shop/warehouse
  // stock is deducted from at issue time. Null/false on a plain "Simple
  // Invoice" line-item-only-in-name record with no real stock effect.
  warehouseId        String?  @map("warehouse_id")
  stockDeducted      Boolean  @default(false) @map("stock_deducted")
  createdAt          DateTime @default(now()) @map("created_at")
  // Client-generated dedup key for offline-queued/retried invoice creation
  // (local-first sync pilot, see STATUS.md) - same pattern already proven
  // by CashSale.clientTxnId, generalized here so a flaky-network sync retry
  // can safely replay-and-return-existing instead of creating a duplicate
  // invoice (the old `INV-${Date.now()}-${random}` number alone offered no
  // such guarantee).
  clientTxnId        String?  @map("client_txn_id")

  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  taxRate      TaxRate?             @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  fund         Fund?                @relation(fields: [fundId], references: [id], onDelete: SetNull)
  warehouse    Warehouse?           @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  creditNotes  CreditNote[]
  payments       InvoicePayment[]
  momoRequests   MomoPaymentRequest[]
  tellerRequests TellerPaymentRequest[]

  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, clientTxnId])
  @@index([tenantId])
  @@index([customerId])
  @@index([status])
  @@index([taxRateId])
  @@index([warehouseId])
  @@index([fundId])
  @@map("invoices")
}

// One row per payment (full or partial) actually recorded against an
// invoice - the audit trail Invoice.amountPaid's running total is built
// from. Each row is exactly one journal entry's worth of Cash/Revenue
// posting (see invoicePaymentService.recordInvoicePayment), so "what did
// this invoice's ledger impact actually consist of" is always fully
// reconstructable from this table alone, not just the current total.
model InvoicePayment {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  invoiceId          String   @map("invoice_id")
  // Native-currency amount of this specific payment (same currency as
  // Invoice.total) - what the accountant actually entered/collected.
  amount             Decimal  @db.Decimal(15, 2)
  // What was actually posted to the ledger for this payment, after the
  // same base-currency conversion invoicePaymentService already applies to
  // the invoice as a whole.
  baseCurrencyAmount Decimal  @map("base_currency_amount") @db.Decimal(15, 2)
  method             String   @default("MANUAL") @map("method")
  journalId          String?  @map("journal_id")
  recordedByUserId   String?  @map("recorded_by_user_id")
  recordedByEmail    String?  @map("recorded_by_email")
  createdAt          DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_payments")
}

// A real MTN Mobile Money "Request to Pay" collection attempt against an
// invoice - the customer gets a USSD prompt on their phone to approve. MTN's
// Collections API has no bulk transaction-history endpoint (unlike Mono's
// bank-feed model), so each attempt is tracked individually here and its
// result learned by polling GET requesttopay/{referenceId}, not by syncing a
// statement. referenceId is the caller-generated X-Reference-Id (a UUID)
// used as the MTN-side handle; externalId is our own invoice-linked
// reference sent in the request body.
model MomoPaymentRequest {
  id                     String   @id @default(uuid())
  tenantId               String   @map("tenant_id")
  invoiceId              String   @map("invoice_id")
  phoneNumber            String   @map("phone_number")
  amount                 Decimal  @db.Decimal(15, 2)
  currency               String   @default("GHS")
  referenceId            String   @unique @map("reference_id")
  externalId             String   @map("external_id")
  status                 String   @default("PENDING")
  financialTransactionId String?  @map("financial_transaction_id")
  failureReason          String?  @map("failure_reason")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([status])
  @@map("momo_payment_requests")
}

// A real TheTeller (PaySwitch) mobile money debit attempt against an
// invoice - covers the networks MTN's own direct MoMo integration above
// doesn't: Telecel Cash, AirtelTigo Money, Zeepay, G-Money, selected via
// `network` (MTN is deliberately excluded here - use MomoPaymentRequest for
// MTN, so the same real-world network never produces two differently-shaped
// payment-request rows across two tables). Unlike MTN's always-202-then-poll
// flow, TheTeller's process endpoint can return a synchronous
// approved/declined result in the same HTTP response - but a real
// USSD-prompt approval flow means a pending outcome is still realistically
// possible, so this is tracked and polled exactly like MoMo for UX
// consistency and as a hedge against an undocumented pending state.
// transactionId is TheTeller's own caller-generated 12-digit numeric
// reference (their `transaction_id`), not a UUID like MTN's referenceId.
model TellerPaymentRequest {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  invoiceId     String   @map("invoice_id")
  network       String   @map("network")
  phoneNumber   String   @map("phone_number")
  amount        Decimal  @db.Decimal(15, 2)
  currency      String   @default("GHS")
  transactionId String   @unique @map("transaction_id")
  status        String   @default("PENDING")
  responseCode  String?  @map("response_code")
  failureReason String?  @map("failure_reason")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([status])
  @@map("teller_payment_requests")
}

// A correction/refund against an already-issued Invoice (returned goods,
// overcharge, negotiated discount, etc.). Because this platform only
// recognizes revenue at payment time (see invoices.ts's `/pay` handler -
// there is no separate Accounts Receivable posting at invoice creation),
// the correct accounting treatment genuinely differs by whether the invoice
// has been paid yet, and `method` records which path was taken rather than
// leaving it to be inferred later from whether `journalId` happens to be set:
//  - INVOICE_REDUCTION (invoice still unpaid): nothing has been posted to
//    the ledger yet, so the credit note simply reduces what the invoice will
//    charge on payment - no journal entry.
//  - JOURNAL_REVERSAL (invoice already paid): revenue and cash were already
//    recognized at the original total, so the credit note posts a real
//    reversing entry (Debit Revenue, Credit Cash) and leaves the invoice's
//    own total/status untouched as the historical record of what was paid.
model CreditNote {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  creditNoteNumber String   @map("credit_note_number")
  invoiceId        String   @map("invoice_id")
  amount           Decimal  @db.Decimal(15, 2)
  reason           String
  method           String
  journalId        String?  @map("journal_id")
  issueDate        DateTime @default(now()) @map("issue_date")
  createdAt        DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, creditNoteNumber])
  @@index([tenantId])
  @@index([invoiceId])
  @@map("credit_notes")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(15, 2)
  amount      Decimal @db.Decimal(15, 2)
  // Set only on an itemized invoice (Invoice.warehouseId is also set in that
  // case) - links this line to a real Chart of Accounts-adjacent inventory
  // item so its stock can be deducted at issue time. Null on a plain/simple
  // invoice line (a service, or any line with nothing to deduct from stock).
  inventoryItemId String? @map("inventory_item_id")

  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([inventoryItemId])
  @@map("invoice_items")
}

model Vendor {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  email     String
  phone     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  bills VendorBill[]

  @@index([tenantId])
  @@map("vendors")
}

model VendorBill {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  billNumber         String   @map("bill_number")
  vendorId           String   @map("vendor_id")
  billDate           DateTime @default(now()) @map("bill_date")
  dueDate            DateTime @map("due_date")
  amount             Decimal  @db.Decimal(15, 2)
  currency           String   @default("USD")
  baseCurrencyAmount Decimal? @map("base_currency_amount") @db.Decimal(15, 2)
  status             String   @default("UNPAID")
  journalId          String?  @map("journal_id")
  createdAt          DateTime @default(now()) @map("created_at")

  // Itemized purchase / goods-receipt fields - all optional/backward-compatible
  // with the original lump-sum bill shape. `warehouseId` + `lines` are set
  // together when a bill represents real inventory received, not a generic
  // expense. `billType`/`landedCostForBillId` distinguish a normal purchase
  // bill from a secondary freight/customs/duty bill whose cost gets spread
  // across a linked primary bill's line items (landed cost allocation).
  warehouseId         String?   @map("warehouse_id")
  billType            String    @default("STANDARD") @map("bill_type")
  landedCostForBillId String?   @map("landed_cost_for_bill_id")
  landedCostAppliedAt DateTime? @map("landed_cost_applied_at")

  // Optional restricted/unrestricted fund this bill's expense belongs to
  // (fund accounting for nonprofit tenants) - flows onto both journal lines
  // posted at payment time (see routes/bills.ts POST /:id/pay).
  fundId String? @map("fund_id")

  vendor     Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  warehouse  Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  fund       Fund?            @relation(fields: [fundId], references: [id], onDelete: SetNull)
  lines      VendorBillLine[]
  debitNotes DebitNote[]

  landedCostForBill VendorBill?  @relation("LandedCostLink", fields: [landedCostForBillId], references: [id], onDelete: SetNull)
  landedCostBills   VendorBill[] @relation("LandedCostLink")

  @@unique([tenantId, billNumber])
  @@index([tenantId])
  @@index([vendorId])
  @@index([status])
  @@index([warehouseId])
  @@index([landedCostForBillId])
  @@index([fundId])
  @@map("vendor_bills")
}

// Mirror of CreditNote for the AP side: a correction/refund against an
// already-issued VendorBill. Same reasoning as CreditNote applies since
// bills.ts's `/pay` handler recognizes the expense only at payment time:
//  - BILL_REDUCTION (bill still unpaid): reduces what the bill will charge
//    on payment, no journal entry since nothing was posted yet.
//  - JOURNAL_REVERSAL (bill already paid): posts a real reversing entry
//    (Debit Cash, Credit Expense - money refunded by the vendor) and leaves
//    the bill's own amount/status untouched as the historical payment record.
model DebitNote {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  debitNoteNumber String   @map("debit_note_number")
  billId          String   @map("bill_id")
  amount          Decimal  @db.Decimal(15, 2)
  reason          String
  method          String
  journalId       String?  @map("journal_id")
  issueDate       DateTime @default(now()) @map("issue_date")
  createdAt       DateTime @default(now()) @map("created_at")

  bill VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([tenantId, debitNoteNumber])
  @@index([tenantId])
  @@index([billId])
  @@map("debit_notes")
}

