enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

// Transactional outbox for the local-first sync pilot (Chart of Accounts +
// Invoices - see STATUS.md). Every syncable write appends exactly one row
// here, in the SAME database transaction as the mutation itself, so a
// change and its log entry always commit or roll back together - this is
// what lets a client trust "changes since sequence N" as complete, and is
// also how a hard DELETE (which otherwise leaves no trace anywhere in this
// schema) becomes visible to a client instead of just vanishing. `sequence`
// is a per-tenant monotonic counter (not a global one) so two tenants'
// change volumes never interfere with each other's cursor math; assigned by
// syncChangeLogService via a row-locked counter read, not a DB identity
// column, because it must be assignable from inside the SAME transaction as
// arbitrary other work (including raw SQL against a per-tenant schema).
model SyncChangeLog {
  id         String        @id @default(uuid())
  tenantId   String        @map("tenant_id")
  entityType String        @map("entity_type")
  entityId   String        @map("entity_id")
  operation  SyncOperation
  // Full current-state snapshot for CREATE/UPDATE (enough for a client to
  // upsert its local copy without a follow-up fetch); null for DELETE - the
  // entityId + operation alone is the tombstone.
  payload    Json?
  sequence   BigInt
  occurredAt DateTime      @default(now()) @map("occurred_at")

  @@unique([tenantId, sequence])
  @@index([tenantId, entityType])
  @@map("sync_change_log")
}

// Backs syncChangeLogService's per-tenant sequence allocation (one row per
// tenant, incremented under a row lock inside the caller's own transaction -
// see recordChange). A dedicated table rather than a Postgres SEQUENCE
// because it needs to be incremented transactionally alongside a
// per-tenant-schema raw-SQL mutation and roll back together with it, which
// a global SEQUENCE (never transactional/rollback-safe by design) can't do.
model SyncSequenceCounter {
  tenantId String @id @map("tenant_id")
  value    BigInt @default(0)

  @@map("sync_sequence_counters")
}

// An employee's out-of-pocket expense claim, distinct from a VendorBill
// (which represents money owed to an external vendor, not a reimbursement
// owed to a staff member). Approval reuses the existing ApprovalWorkflow
// engine (entityType 'ExpenseClaim') rather than a bespoke chain -
// expenseAccountId is a bare id (not a Prisma relation) because Account
// lives in the tenant's own per-tenant Postgres schema, not `public`, the
// same cross-schema-boundary reason TaxRate/Invoice never relate directly
// to Account either.
model ExpenseClaim {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  claimNumber        String    @map("claim_number")
  submittedBy        String    @map("submitted_by")
  submittedByName    String    @map("submitted_by_name")
  category           String
  description        String
  amount             Decimal   @db.Decimal(15, 2)
  currency           String    @default("USD")
  expenseDate        DateTime  @map("expense_date")
  expenseAccountId   String?   @map("expense_account_id")
  status             String    @default("PENDING_APPROVAL")
  approvalWorkflowId String?   @map("approval_workflow_id")
  journalId          String?   @map("journal_id")
  reimbursedAt       DateTime? @map("reimbursed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, claimNumber])
  @@index([tenantId])
  @@index([status])
  @@index([submittedBy])
  @@map("expense_claims")
}

// Platform-wide (no tenantId - the same tax/regulatory rules apply to every
// tenant in a given jurisdiction) record of when Ledgio last verified its
// compliance data (e.g. Ghana VAT/NHIL/GETFund rates) against the real
// regulator source. Lets Settings/Reports show a provable "last verified"
// date instead of an unverifiable claim. Writes are gated by the platform
// admin passcode (BroadcastService.verifyPasscode), the same mechanism
// AuditLog's platform-wide entries and AdminCoreEngine use - never by a
// per-tenant Admin role, since one tenant's admin must never be able to
// fabricate a compliance claim every other tenant would also see.
model ComplianceUpdate {
  id          String   @id @default(uuid())
  source      String
  area        String
  description String
  verifiedAt  DateTime @map("verified_at")
  verifiedBy  String?  @map("verified_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([verifiedAt(sort: Desc)])
  @@map("compliance_updates")
}
