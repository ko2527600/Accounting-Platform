PORT=4000
NODE_ENV=development

# Database Configuration with Connection Pool Settings
# Connection pool parameters:
# - connection_limit: Maximum number of connections (default: 10, recommended: 50 for production)
# - pool_timeout: Time in seconds to wait for a connection from the pool (default: 10)
# - connect_timeout: Time in seconds to wait for a new connection to be established (default: 5)
# - statement_timeout: Maximum time in milliseconds for a query to run (default: none, recommended: 30000)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/accounting_db?schema=public&connection_limit=50&pool_timeout=10&connect_timeout=5&statement_timeout=30000"

# Direct (non-pooled) connection - REQUIRED whenever DATABASE_URL is set, even
# if it's identical to DATABASE_URL (Prisma errors on migrate commands if this
# env var is missing once directUrl is declared in schema.prisma). Only needs
# to differ from DATABASE_URL when DATABASE_URL itself is a pooled connection
# - e.g. Prisma Postgres's pooled.db.prisma.io endpoint - in which case this
# should be Prisma Postgres's direct db.prisma.io endpoint instead, since
# `prisma migrate deploy`/`migrate dev` need a session-continuous connection.
# (This app's own SET LOCAL search_path tenant-switching is transaction-scoped
# and pooler-safe, so DATABASE_URL alone is fine for normal runtime queries.)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/accounting_db?schema=public&connection_limit=50&pool_timeout=10&connect_timeout=5&statement_timeout=30000"

# Tenant-scoped query transaction timeouts (milliseconds). Every tenant-scoped
# query runs inside one Prisma interactive $transaction (withTenantDb, so
# SET LOCAL search_path is transaction-scoped and pooler-safe) - Prisma's own
# defaults (maxWait 2000ms, timeout 5000ms) assume near-zero DB latency and
# get exceeded in real production conditions (slow connection pooler, cold
# start), surfacing as an unhelpful 500 on any request doing more than a
# couple of sequential queries (e.g. bulk item import). Raise these if still
# seeing transaction-timeout errors in production logs.
PRISMA_TX_TIMEOUT_MS=25000
PRISMA_TX_MAX_WAIT_MS=10000

# JWT Secret (REQUIRED - the app refuses to start signing/verifying tokens without it)
# Generate with: openssl rand -base64 32
JWT_SECRET="super-secret-jwt-key-for-accounting-platform-dev"

# Admin Broadcast master passcode (REQUIRED for the /admin/core-engine broadcast console)
# Generate with: openssl rand -base64 24
BROADCAST_MASTER_SECRET=""

# At-rest encryption key for third-party API credentials tenants enter themselves
# (currently: the GRA VSDC security_key - see utils/credentialEncryption.ts).
# REQUIRED before any tenant can save GRA E-VAT credentials in Settings.
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=""

# GRA E-VAT / VSDC Certified Invoicing System - see graEvatService.ts. The
# only host GRA's own Postman API documentation names is their staging
# environment; GRA has not published a separate production host in the
# documentation this was built from, so this defaults to staging until a
# taxpayer's GRA-assigned production URL (if different) is confirmed and set
# here. Each tenant's own TIN/device number/security_key (entered in Settings)
# are what's actually assigned per-taxpayer during GRA's onboarding - this
# base URL is the only piece that's platform-wide.
GRA_EVAT_API_BASE_URL="https://vsdcstaging.vat-gh.com"

# Mono (open banking) bank-feed integration - both required to link real bank
# accounts via POST /api/v1/banking/connect. Without these, that endpoint
# returns 503 rather than falling back to fake demo data. Get credentials at
# https://app.mono.co
MONO_SECRET_KEY=""
MONO_WEBHOOK_SECRET=""

# Paystack - hosted-checkout "Pay Now" link on invoices, and per-tenant
# Subaccounts for payment collection (card, bank transfer, and Mobile Money -
# MTN/AirtelTigo/Telecel Cash - all through the same hosted checkout, settling
# directly to each tenant's own bank/MoMo account). Unset means
# POST /api/v1/invoices/:id/paystack/initialize returns 503 rather than
# faking a checkout link. Get a secret key (test or live) from your Paystack
# Dashboard's Settings > API Keys & Webhooks at https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=""
# Defaults to Paystack's live API; there is no separate sandbox host - test
# mode is selected by using a test secret key (sk_test_...) instead of a live
# one (sk_live_...), same key/URL either way.
PAYSTACK_BASE_URL="https://api.paystack.co"
# Optional - where Paystack's hosted checkout redirects the customer after
# they pay. Purely informational to the customer; the actual invoice-paid
# state is only ever set by an accountant clicking "Verify Payment" (or a
# future webhook), which calls Paystack's verify API directly.
PAYSTACK_CALLBACK_URL=""

# Live currency conversion (exchangerate-api.com) - required for invoices/bills
# created in a currency other than the tenant's base currency to convert
# correctly when posted to the ledger. Same-currency invoices/bills never need
# this. Without it, creating a cross-currency invoice/bill returns a clear 503
# rather than posting the wrong amount. Get a free key at https://www.exchangerate-api.com
FX_RATE_API_KEY=""

# Outbound transactional email via direct Gmail SMTP (nodemailer) - required
# for verification emails, staff invitations, and the Quick Start Guide PDF
# to actually send. Without both vars set, EmailService.sendMail() logs the
# failure and returns false rather than sending.
# Many cloud hosts block outbound SMTP ports to prevent spam abuse - this was
# true on Render's Free tier (confirmed ETIMEDOUT on both port 465 and 587),
# but port 465 connects successfully on Render's Starter plan and up
# (live-confirmed 2026-08-17). If SMTP starts failing again after a plan
# downgrade, EmailService.ts's header comment explains the fallback.
# EMAIL_USER is the sending Gmail address; EMAIL_PASS MUST be a Gmail App
# Password (https://myaccount.google.com/apppasswords - requires 2-Step
# Verification enabled), never the account's real login password.
EMAIL_USER=""
EMAIL_PASS=""

# Outbound SMS (verification codes, cash-shortage alerts). Checked in order:
# Arkesel (ARKESEL_API_KEY) -> mNotify (MNOTIFY_API_KEY) -> Android SMS Gateway
# (SMS_GATEWAY_* below, via sms-gate.app). Without any of these configured,
# SmsService logs a GATEWAY_NOT_CONFIGURED audit entry and returns false rather
# than sending through a shared/demo account.
ARKESEL_API_KEY=""
MNOTIFY_API_KEY=""
SMS_GATEWAY_URL=""
SMS_GATEWAY_USER=""
SMS_GATEWAY_PASS=""
SMS_SENDER_ID=""

# CORS allowed origins - comma-separated list of frontend origins allowed to make
# credentialed cross-origin requests (e.g. "https://app.example.com,https://admin.example.com").
# Falls back to APP_URL, then to the local Vite dev server, if unset.
CORS_ALLOWED_ORIGINS=""

# Public URL of the frontend app (used for email verification/invite links and as a CORS fallback)
APP_URL="http://localhost:5173"

# Number of reverse-proxy hops to trust for X-Forwarded-For (Express "trust proxy").
# Leave unset if this API is reachable directly (no proxy/load balancer in front) -
# that's the safe default and matches local dev. Set to "1" if there's exactly one
# reverse proxy (e.g. the bundled nginx.conf) in front of this process, higher if
# there's an additional load balancer in front of that. Setting this incorrectly
# either makes rate limiting trust a spoofable header (too high) or collapses every
# real user into one shared rate-limit bucket (unset, when a proxy IS present).
TRUST_PROXY=""

# Redis Configuration (for distributed caching and rate limiting)
# Format: redis://[username]:[password]@[host]:[port]/[db_number]
# For Redis Cluster: redis://host1:port1,host2:port2,host3:port3
REDIS_URL="redis://localhost:6379/0"

# OpenTelemetry Configuration (for distributed tracing)
# Set OTEL_ENABLED=false to disable telemetry
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_SERVICE_NAME="accounting-platform-backend"

# Hostname for logging (automatically set in containerized environments)
# HOSTNAME=""

# In-app Help Assistant (Claude, via the Anthropic API) - answers user
# questions about how the platform works, and can look up that tenant's own
# data (invoices, ledger, till status, etc.) through the same authenticated
# endpoints the UI itself uses. Unset means the Help Assistant widget shows
# a "not configured" state and POST /api/v1/help-assistant/chat returns 503,
# rather than faking a response. Get a key at https://console.anthropic.com.
ANTHROPIC_API_KEY=""
# Optional - defaults to claude-sonnet-5 if unset.
HELP_ASSISTANT_MODEL=""

